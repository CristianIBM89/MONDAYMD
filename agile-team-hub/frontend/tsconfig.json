{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": false,
    "outDir": "build",
    "baseUrl": "src",
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["src"]
}
