# =============================================
# Agile Team Hub — Backend — Variables de entorno
# Copiar este archivo como .env y completar los valores reales.
# NUNCA incluir el archivo .env en el repositorio.
# =============================================

# Servidor
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
APP_URL=https://your-app-domain.ibm.com
CORS_ORIGIN=https://your-app-domain.ibm.com

# IBM watsonx.ai
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_SPACE_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_REGION=us-south
WATSONX_API_VERSION=2024-05-31
WATSONX_TIMEOUT=60000

# Monday.com GraphQL API
MONDAY_API_TOKEN=your_monday_api_token_here
MONDAY_API_VERSION=2024-10
MONDAY_SESSIONS_BOARD_ID=your_sessions_board_id
MONDAY_BLOCKERS_BOARD_ID=your_blockers_board_id
MONDAY_ITERATIONS_BOARD_ID=your_iterations_board_id
MONDAY_SHOWCASE_BOARD_ID=your_showcase_board_id
MONDAY_RETRO_BOARD_ID=your_retro_board_id

# Microsoft Graph API (opcional — para metadatos de reuniones)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_REDIRECT_URI=https://your-app-domain.ibm.com/auth/callback

# Slack (opcional)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Seguridad
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRY=8h
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=text/plain,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Audit log
AUDIT_LOG_ENABLED=true
