# ============================================================
#  CONFIGURACIÓN — Teams Meeting Summarizer
#  Copia este archivo como .env y rellena tus valores
# ============================================================

# App
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./meetings.db

# ============================================================
#  IBM watsonx.ai  (GRATUITO con cuenta corporativa IBM)
#  Plan Lite: 50 000 tokens/mes gratis
#
#  Cómo obtener las credenciales:
#  1. Ve a https://cloud.ibm.com  (usa tu email @ibm.com)
#  2. Crea una instancia de "watsonx.ai" (plan Lite = gratis)
#  3. En la instancia → "Service credentials" → "New credential"
#  4. Copia el campo "apikey"  →  IBM_API_KEY
#  5. Ve a https://dataplatform.cloud.ibm.com/wx/home
#     → crea o abre un proyecto → copia el Project ID de la URL
#     →  IBM_PROJECT_ID
# ============================================================
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_watsonx_project_id_here
IBM_REGION=us-south
IBM_MODEL_ID=ibm/granite-13b-instruct-v2

# ============================================================
#  MONDAY.COM API  (gratuito con cuenta existente)
#  1. monday.com → perfil → Developers → My Access Tokens
#  2. Copia el token  →  MONDAY_API_KEY
#  3. URL de un workspace: app.monday.com/boards?workspaceId=XXXXX
#     →  MONDAY_WORKSPACE_ID
# ============================================================
MONDAY_API_KEY=your_monday_api_token_here
MONDAY_WORKSPACE_ID=your_workspace_id_here
